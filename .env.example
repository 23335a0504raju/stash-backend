# Stash Backend — Environment Variables
# Copy this to .env and fill in your values

# ─── RapidAPI ──────────────────────────────────────────────────────────────────
# Get your free key at https://rapidapi.com
# Subscribe to:
#   - instagram-scraper-api2 (by social-api1-instagram)  — free plan
#   - yt-api (by ytjar)                                  — free plan
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Add your web app origin and your Expo Go / app origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,exp://localhost:8081

# ─── Feedback Email ─────────────────────────────────────────────────────────────
# Used by POST /api/feedback to email you when users submit feedback.
#
# IMPORTANT: Render's free tier (and many hosts) BLOCK outbound SMTP ports, so
# Gmail/nodemailer hangs and feedback never sends in production. Use Resend's
# HTTP API in production — it goes over HTTPS (port 443) and is not blocked.
#
# ── Resend (PREFERRED — set these on Render) ──
#   1. Sign up at https://resend.com  → API Keys → create one (starts with re_)
#   2. (To send from your own domain) verify a domain under Resend → Domains.
#      To just test, use onboarding@resend.dev as RESEND_FROM — but it can only
#      send TO the email you signed up with.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Stash Feedback <onboarding@resend.dev>

# Where feedback emails are delivered (used by both Resend and SMTP).
EMAIL_TO=youremail@gmail.com

# ── Gmail SMTP (fallback — works for LOCAL dev only, blocked on Render free tier) ──
# Only needed if you don't set RESEND_API_KEY. Get a 16-char App Password:
#   1. https://myaccount.google.com/security → enable 2-Step Verification
#   2. Search "App passwords" → Mail / Other → "Stash Backend" → Generate
EMAIL_FROM=yourgmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
