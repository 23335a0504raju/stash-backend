# Stash Backend — Environment Variables
# Copy this to .env and fill in your values

# ─── RapidAPI ──────────────────────────────────────────────────────────────────
# Get your free key at https://rapidapi.com
# Subscribe to:
#   - instagram-scraper-api2 (by social-api1-instagram)  — free plan
#   - yt-api (by ytjar)                                  — free plan
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Add your web app origin and your Expo Go / app origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,exp://localhost:8081

# ─── Feedback Email (nodemailer + Gmail SMTP) ──────────────────────────────────
# Used by POST /api/feedback to email you when users submit feedback.
#
# Step-by-step to get your App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search "App passwords" → click it
#   4. Select app: Mail, device: Other → type "Stash Backend" → Generate
#   5. Copy the 16-char password shown (format: xxxx xxxx xxxx xxxx)
#
# EMAIL_FROM and EMAIL_TO can be the same address (email yourself).
EMAIL_FROM=yourgmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_TO=youremail@gmail.com
